{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/lint.py",
            "timeout": 30,
            "statusMessage": "Running ruff check..."
          }
        ]
      }
    ]
  }
}
